        <item>
            <id>https://lapin.ithome.com/html/digi/994210.htm</id>
            <title>比闲鱼还划算：小白熊 UD2 消毒烘干暖奶器 999 → 588 元，全玻璃壶次日达</title>
            <link>https://lapin.ithome.com/html/digi/994210.htm</link>
            <guid isPermaLink="false">https://lapin.ithome.com/html/digi/994210.htm</guid>
            <pubDate></pubDate>
            <updated>Tue, 25 Aug 2026 13:15:09 GMT</updated>
                
                
